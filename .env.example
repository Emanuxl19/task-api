# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit secrets.

# ─── JWT ─────────────────────────────────────────────────────────────────
# Generate a strong secret (>= 32 bytes for HS256):
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-strong-base64-secret

# ─── PostgreSQL ──────────────────────────────────────────────────────────
# Used by both the `postgres` service and the `app` service in docker-compose.
# Pick a strong password — do NOT keep "postgres"/"postgres" in any environment.
POSTGRES_DB=taskdb
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# ─── OAuth2 — Google ─────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── OAuth2 — GitHub ─────────────────────────────────────────────────────
# Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── CORS / OAuth2 redirect ──────────────────────────────────────────────
# Defaults are fine for local dev; override in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
